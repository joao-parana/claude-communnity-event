# Copie para .env e preencha. O .env NÃO vai para o git.

# --- backend ---
FILA_CERTA_ENV=dev
FILA_CERTA_DB_PATH=./data/fila_certa.duckdb
# diretório do clone de https://github.com/CIT-SME-RJ/dadoscreche
FILA_CERTA_DADOS_PATH=../../dadoscreche

# --- Web Push (VAPID) ---
# gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.rio

# --- canais simulados na demo ---
# fake | real  — 'fake' registra a tentativa sem enviar nada
CANAL_WHATSAPP_MODO=fake
CANAL_SMS_MODO=fake
CANAL_EMAIL_MODO=fake

# --- frontend ---
VITE_API_BASE_URL=http://localhost:8000
